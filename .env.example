# Required application configuration
# Generate with: npx auth secret
AUTH_SECRET=

MONGODB_URI=mongodb://127.0.0.1:27017/seo_automation
# Public origin used for sign-in callbacks, Google OAuth, and WordPress setup links
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public canonical URL for marketing pages
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production rate limits must use a client IP header overwritten by the trusted ingress proxy.
# Never choose a header that clients can set directly or expose the app around that proxy.
TRUSTED_CLIENT_IP_HEADER=

# Email sign-in codes, team invitation emails, and email MFA codes (optional when using Google-only sign-in;
# production requires this pair or the Google sign-in pair below; invitations fall back to a copyable link without it)
# Option A (no domain needed): send from a Gmail account using a Google App Password
# (Google Account > Security > 2-Step Verification on > App passwords). Used first when set.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option B: Resend. Create an API key and verify the sender domain first
RESEND_API_KEY=
# Must be a verified Resend sender, for example: SEO Studio <login@example.com>
# With Gmail, only the display name ("SEO Studio") is used.
AUTH_EMAIL_FROM=

# Public business details displayed on the Terms and Conditions page.
# Fill these with accurate legal and grievance contact information before launch.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# Google OAuth web client used for Auth.js sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Search Console, GA4, Merchant Center, and Business Profile OAuth
# The integrations reuse AUTH_GOOGLE_ID/AUTH_GOOGLE_SECRET above by default.
# Leave these blank to use that same client, or set both to override it with a
# dedicated Google reporting client. Register both callbacks on the selected
# web client when it also handles Auth.js sign-in:
# Local: http://localhost:3000/api/auth/callback/google
#        http://localhost:3000/api/integrations/google/callback
# Production: https://your-host.example/api/auth/callback/google
#             https://your-host.example/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Required for Google reporting OAuth token storage, even when reusing the
# Auth.js client. Keep this separate from AUTH_SECRET and back it up securely.
# Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Required when authenticator MFA is enabled. It must decode to exactly 32 bytes.
# Generate a distinct key with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# Optional server-side encryption for app-initiated WordPress metadata updates
# Generate a distinct key with: openssl rand -base64 32
WORDPRESS_TOKEN_ENCRYPTION_KEY=

# Google PageSpeed Insights API key. Optional for manual requests; required for
# scheduled PageSpeed checks to avoid relying on unauthenticated API quotas.
GOOGLE_PAGESPEED_API_KEY=

# Background scheduler authentication (required to run crawl, rank tracking, and PageSpeed jobs)
# Generate a random value at least 32 characters long. Configure a trusted scheduler to POST
# /api/cron/scheduled-audits (queues one due website crawl), /api/cron/crawl-jobs
# (executes one queued crawl), /api/cron/scheduled-rank-tracking, /api/cron/scheduled-pagespeed,
# /api/cron/marketplace-instagram, and /api/cron/marketplace-realtime with
# Authorization: Bearer <CRON_SECRET>. Run crawl-jobs about once per minute so queued jobs
# and retries make progress; call due-job schedulers every 5–15 minutes. The Instagram worker
# should run at least daily; the realtime outbox worker should run every 1–5 minutes.
# Scheduled rank tracking also requires DataForSEO. Marketplace payments remain disabled.
CRON_SECRET=
# Per-crawl page ceiling (10–250; default 100). Website settings can choose a
# lower limit. Queue workers honor the smaller of this ceiling and the setting.
SEO_CRAWL_MAX_PAGES=100

# SEO research provider (optional; reports run only after a workspace member starts one)
# DataForSEO charges according to your account and selected API endpoints.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Future integrations (not consumed by the current application; setting these does not enable features)
# AI feature implementation and prompt-injection controls are still pending.
OPENAI_API_KEY=
# Billing routes, plans, checkout and webhook verification are still pending.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Error monitoring integration is not wired into the runtime yet.
SENTRY_DSN=

# Digital marketing marketplace (India launch, INR)
# Comma-separated email addresses for marketplace administrators. These users must
# sign in through the normal verified Google or email-code flow.
MARKETPLACE_ADMIN_EMAILS=

# Meta Instagram professional-account verification. Register the callback:
# https://your-host.example/api/marketplace/meta/callback
# Requires Meta App Review and approved Instagram permissions for live users,
# including instagram_business_basic and instagram_business_manage_insights.
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
# Generate separately with: openssl rand -base64 32
META_TOKEN_ENCRYPTION_KEY=

# Payments are disabled for this release. These placeholders are reserved for a
# future, separately approved payment launch. Setting credentials does not enable
# checkout, escrow, commissions, refunds, wallets or payouts.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set and save the same 0–3000 basis-point commission in the marketplace admin
# settings before checkout is enabled. This env fallback is optional.
MARKETPLACE_COMMISSION_BPS=

# Ably private conversation channels (server key; never use in NEXT_PUBLIC_*).
# Enables live message refresh and online presence. Without it, the inbox polls.
ABLY_API_KEY=

# Collaboration message attachments (JPEG, PNG, WebP, MP4, PDF; 10 MB each)
# are stored privately in MongoDB GridFS. Production media scanning, storage
# quotas, and retention cleanup still need a deployment service and policy.
